\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeZavala}[2026/11/12 research presentation theme v3]
\RequirePackage{tikz}
\RequirePackage{lmodern}
\mode<presentation>

% White canvas. The site's ink, steel and rust sit beside a navy heading and a copper rule.
\definecolor{ZavalaInk}{HTML}{1F2A24}
\definecolor{ZavalaSteel}{HTML}{46616C}
\definecolor{ZavalaRust}{HTML}{753729}
\definecolor{ZavalaRule}{HTML}{CFC4B2}
\definecolor{ZavalaNavy}{HTML}{142332}
\definecolor{ZavalaCopper}{HTML}{D97A43}

\usefonttheme[onlymath]{serif}
\setbeamersize{text margin left=7mm,text margin right=7mm}
\setbeamercolor{normal text}{fg=ZavalaInk,bg=white}
\setbeamercolor{background canvas}{bg=white}
\setbeamercolor{structure}{fg=ZavalaRust}
\setbeamercolor{frametitle}{fg=ZavalaNavy}
\setbeamercolor{framesubtitle}{fg=ZavalaSteel}
\setbeamercolor{zavala rail}{fg=white,bg=ZavalaSteel}
\setbeamercolor{zavala foot}{fg=ZavalaSteel,bg=white}
\setbeamercolor{button}{fg=ZavalaRust,bg=white}
\setbeamercolor{button border}{fg=ZavalaRule}
\setbeamerfont{button}{size=\scriptsize,series=\bfseries}
\setbeamerfont{frametitle}{size*={13.4pt}{17pt},series=\bfseries}
\setbeamerfont{zavala lead}{size*={13.4pt}{17pt}}
\setbeamerfont{zavala emphasis}{size*={11pt}{13pt}}
\setbeamerfont{framesubtitle}{size=\small,series=\mdseries}
\setbeamerfont{zavala navigation}{size=\scriptsize}
\setbeamertemplate{navigation symbols}{}
\setlength{\leftmargini}{1.35em}
\setlength{\leftmarginii}{1.35em}
\setbeamertemplate{itemize item}{\raise.15ex\hbox{\scriptsize\textbullet}}
\setbeamercolor{itemize subitem}{fg=ZavalaSteel}
\setbeamertemplate{itemize subitem}{\textendash}

\newcommand{\SlideGroup}[1]{{\usebeamercolor[fg]{frametitle}\bfseries #1\par}}

\makeatletter
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=7mm,rightskip=7mm]{frametitle}
    \vskip2.7mm\usebeamerfont{frametitle}\insertframetitle\par
    \ifx\insertframesubtitle\@empty\else
      \vskip.6mm{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi
    \vskip1mm
  \end{beamercolorbox}%
}

% Read Beamer's navigation entries so the dots count frames, including a
% frame with several overlays only once. Anchors lead to its first overlay.
\newcount\zavala@count
\newcount\zavala@position
\def\zavala@countframe#1/#2\relax{%
  \advance\zavala@count by1\relax
  \ifnum#1>\c@page\else\advance\zavala@position by1\relax\fi
}
\def\zavala@dot#1/#2\relax{%
  \hyperlink{Navigation#1}{%
    \tikz[baseline=-.42ex]{%
      \path[use as bounding box] (-1.05mm,-.85mm) rectangle (1.05mm,.85mm);
      \ifnum#1>\c@page
        \draw[white,line width=.38pt] (0,0) circle[radius=.42mm];
      \else
        \fill[white] (0,0) circle[radius=.42mm];
        \ifnum#2<\c@page\else
          \draw[white,line width=.38pt] (0,0) circle[radius=.72mm];
        \fi
      \fi
    }%
  }%
}
\newcommand{\zavala@sections}{%
  \begingroup
  \def\slideentry##1##2##3##4##5##6{}%
  \def\sectionentry##1##2##3##4##5{%
    \ifnum##5=\c@part
      \hyperlink{Navigation##3}{%
        \ifnum##1=\c@section
          {\bfseries\underline{##2}}%
        \else
          {##2}%
        \fi
      }\hspace{4mm}%
    \fi
  }%
  \dohead\endgroup
}
\newcommand{\zavala@progress}{%
  \begingroup
  \zavala@count=0\relax\zavala@position=0\relax
  \def\sectionentry##1##2##3##4##5{}%
  \def\slideentry##1##2##3##4##5##6{%
    \ifnum##6=\c@part\ifnum##1=\c@section\ifnum##1>0
      \zavala@countframe##4\relax
    \fi\fi\fi
  }%
  \dohead
  \ifnum\zavala@count>12
    \the\zavala@position\,/\,\the\zavala@count
  \else
    \def\slideentry##1##2##3##4##5##6{%
      \ifnum##6=\c@part\ifnum##1=\c@section\ifnum##1>0
        \zavala@dot##4\relax
      \fi\fi\fi
    }%
    \dohead
  \fi
  \endgroup
}
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.8mm,dp=1.8mm,leftskip=7mm,rightskip=7mm]{zavala rail}
    \usebeamerfont{zavala navigation}%
    \ifbeamer@inappendix
      {\bfseries Backup}%
    \else
      \zavala@sections\hfill\zavala@progress
    \fi
  \end{beamercolorbox}%
  {\color{ZavalaRule}\hrule height .28pt}%
}
\setbeamertemplate{footline}{%
  {\color{ZavalaRule}\hrule height .28pt}%
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.4mm,dp=1.6mm,leftskip=7mm,rightskip=7mm]{zavala foot}
    \usebeamerfont{zavala navigation}%
    \hbox to\dimexpr\paperwidth-14mm\relax{%
      \makebox[.22\paperwidth][l]{\bfseries\insertshortauthor}%
      \hfil\insertshortdate\hfil
      \makebox[.22\paperwidth][r]{%
        \ifbeamer@inappendix A\insertframenumberinappendix
        \else\insertframenumber\,/\,\insertmainframenumber\fi}%
    }%
  \end{beamercolorbox}%
}

\setbeamertemplate{title page}{%
  \vspace*{1mm}
  {\color{ZavalaSteel}\small\bfseries\insertshortdate\par}
  \vspace{3.5mm}
  {\color{ZavalaCopper}\rule{13mm}{1.2pt}\par}
  \vspace{4mm}
  {\color{ZavalaNavy}\fontfamily{ppl}\selectfont\fontsize{20}{23}\selectfont\inserttitle\par}
  \vspace{6mm}
  {\color{ZavalaNavy}\usebeamerfont{zavala emphasis}\bfseries\insertauthor\par}
  \vspace{1.2mm}
  {\color{ZavalaSteel}\small\insertinstitute\par}
}
\newcommand{\ZavalaTitle}{%
  \begingroup
  \setbeamercolor{background canvas}{bg=white}%
  \begin{frame}[plain,noframenumbering]\titlepage\end{frame}%
  \endgroup
}
\newcommand{\TalkLink}[2]{\hyperlink{#1<1>}{\beamerbutton{#2}}}
\newcommand{\ExhibitNote}[1]{%
  \par\vspace{1mm}{\usebeamercolor[fg]{zavala foot}\scriptsize #1\par}%
}
\makeatother
\mode<all>
